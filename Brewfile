# Taps
tap "homebrew/bundle"
tap "homebrew/cask-fonts"
tap "homebrew/services"

##############################################################################
## CORE UTILITIES - System & essential tools
##############################################################################

brew "coreutils"      # GNU core utilities
brew "curl"           # Data transfer
brew "wget"           # Web downloader
brew "git"            # Version control
brew "gh"             # GitHub CLI
brew "gnupg"          # Encryption & signing
brew "openssh"        # SSH tools
brew "openssl"        # Cryptography

##############################################################################
## SHELL & TERMINAL - Modern shell environment
##############################################################################

brew "zsh"            # Modern shell
brew "starship"       # Fast, minimal prompt
brew "tmux"           # Terminal multiplexer

##############################################################################
## MODERN CLI TOOLS - Essential replacements for old UNIX tools
##############################################################################

brew "bat"            # cat replacement (syntax highlighting)
brew "eza"            # ls replacement (colors, icons)
brew "fd"             # find replacement (fast, intuitive)
brew "ripgrep"        # grep replacement (fast, regex)
brew "zoxide"         # cd replacement (smart navigation)
brew "fzf"            # Fuzzy finder (interactive selection)
brew "jq"             # JSON processor
brew "yq"             # YAML processor

##############################################################################
## FILE & TEXT TOOLS
##############################################################################

brew "unzip"          # Archive extraction
brew "tree"           # Directory visualization
brew "ncdu"           # Disk usage analyzer

##############################################################################
## DEVELOPMENT TOOLS - Languages & build essentials
##############################################################################

brew "make"           # Build automation
brew "git-delta"      # Beautiful git diffs

##############################################################################
## GIT ENHANCEMENTS
##############################################################################

