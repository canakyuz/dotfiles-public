##############################################################################
# 👤 Professional Developer Dotfiles - Brewfile.personal (OPTIONAL)
# Personal applications, productivity, media, and utilities
#
# Install with: brew bundle install --file Brewfile.personal
#
# Note: These are NOT required for development. Choose what suits your needs.
##############################################################################

tap "homebrew/bundle"

##############################################################################
## PRODUCTIVITY & NOTE-TAKING
##############################################################################

cask "notion"          # All-in-one workspace
cask "obsidian"        # Knowledge base & note-taking
cask "todoist"         # Task management
cask "toggl-track"     # Time tracking

##############################################################################
## SYSTEM UTILITIES
##############################################################################

cask "alfred"          # Spotlight alternative
cask "raycast"         # Command launcher
cask "the-unarchiver"  # Archive handler
cask "appcleaner"      # App uninstaller

##############################################################################
## VERSION CONTROL GUIs (Optional - CLI tools already in Brewfile)
##############################################################################

cask "github-desktop"  # GitHub desktop client
cask "gitkraken"       # Git client
cask "sourcetree"      # Bitbucket/Git client

##############################################################################
## COMMUNICATION (Optional - Not needed for development)
##############################################################################

# cask "slack"          # Team chat
# cask "discord"        # Community chat
# cask "zoom"           # Video conferencing
# cask "microsoft-teams" # Microsoft Teams

##############################################################################
## BROWSERS (Optional - Development browsers already installed)
##############################################################################

# cask "google-chrome"
# cask "firefox"
# cask "brave-browser"
# cask "arc"            # New browser

##############################################################################
## MEDIA & ENTERTAINMENT
##############################################################################

cask "vlc"             # Video player
cask "iina"            # macOS native video player
# cask "spotify"       # Music streaming (commented out)

##############################################################################
## MONITORING & SYSTEM INFO
##############################################################################

# Uncomment if needed (basic tools already in Brewfile)
# brew "htop"          # Process monitor
# brew "glances"       # System monitoring
# brew "neofetch"      # System info display

##############################################################################
## FONTS (Additional programmer fonts - core fonts in Brewfile)
##############################################################################

tap "homebrew/cask-fonts"

cask "font-fira-code-nerd-font"
cask "font-hack-nerd-font"
cask "font-source-code-pro"
