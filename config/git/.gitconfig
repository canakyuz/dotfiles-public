[user]
    # ⚠️ CONFIGURE THESE WITH YOUR DETAILS:
    # git config --global user.name "Your Name"
    # git config --global user.email "your.email@example.com"
    name = Developer
    email = dev@example.com

[core]
    editor = nano
    whitespace = space-before-tab,-indent-with-non-tab,trailing-space
    filemode = false
    pager = less -FRSX

[init]
    defaultBranch = main

[pull]
    ff = only
    rebase = true

[push]
    default = simple
    followTags = true

[fetch]
    prune = true

[branch]
    autosetuprebase = always

[diff]
    renames = copies

[merge]
    conflictstyle = diff3

[rebase]
    autoStash = true

[log]
    abbrevCommit = true
    decorate = short

[alias]
    st = status
    co = checkout
    br = branch
    ci = commit
    unstage = reset HEAD --
    last = log -1 HEAD
    visual = log --graph --oneline --all

[color]
    ui = true
